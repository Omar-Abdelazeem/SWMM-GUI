<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Import Condition="Exists('$(BDS)\bin\CodeGear.Deployment.targets')" Project="$(BDS)\bin\CodeGear.Deployment.targets"/>
    <ProjectExtensions>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <PropertyGroup/>
    <ItemGroup Condition="'$(Platform)'=='Win64'"/>
    <ItemGroup Condition="'$(Platform)'=='Win64x'"/>
    <ItemGroup Condition="'$(Platform)'=='Win32'">
        <DeployFile Include="viewvars.txt" Condition="'$(Config)'=='Release'">
            <RemoteDir>Epaswmm5\</RemoteDir>
            <RemoteName>viewvars.txt</RemoteName>
            <DeployClass>ProjectFile</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="C:\Projects\Swmm5.2\Swmm5.2.4\GUI\Win32\Epaswmm5.exe" Condition="'$(Config)'=='Release'">
            <RemoteDir>Epaswmm5\</RemoteDir>
            <RemoteName>Epaswmm5.exe</RemoteName>
            <DeployClass>ProjectOutput</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
            <Required>True</Required>
        </DeployFile>
        <DeployFile Include="objprops.txt" Condition="'$(Config)'=='Release'">
            <RemoteDir>Epaswmm5\</RemoteDir>
            <RemoteName>objprops.txt</RemoteName>
            <DeployClass>ProjectFile</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="..\..\..\swmm5.dll" Condition="'$(Config)'=='Release'">
            <RemoteDir>Epaswmm5\</RemoteDir>
            <RemoteName>swmm5.dll</RemoteName>
            <DeployClass>File</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
    </ItemGroup>
</Project>
